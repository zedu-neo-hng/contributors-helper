# OpenRouter API key for server-side AI requests.
# AI_API_KEY=
# Shared secret that also unlocks the upload/ingest API for scripted (non-browser) runs,
# sent as the x-ingest-secret header. Signed-in admins can upload/ingest from the UI, so
# this is optional but required for curl/cron triggers.
# INGEST_SECRET=
# Comma-separated emails that are always super admins. A super admin can promote other
# contributors to admin and trigger ingestion from the UI.
# SUPER_ADMIN_EMAILS=
# Postgres connection string (used by Prisma).
# DATABASE_URL="postgresql://user:password@localhost:5432/contributors_helper"
# Directory holding the compacted call knowledge base (summaries/ and transcripts/).
# Optional; defaults to ./clean-transcripts.
# KNOWLEDGE_DIR=
# Google OAuth client ID and secret for user authentication.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXTAUTH_URL=
# NEXTAUTH_SECRET=
