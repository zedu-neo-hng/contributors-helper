# Server-side Groq API key. Never prefix this with NEXT_PUBLIC_.
AI_API_KEY=

# Configure an administrator account and a random session signing secret (32+ chars).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional: admin or lead. Defaults to admin.
ADMIN_ROLE=admin

# Feedback file location. Mount a persistent Coolify volume at /app/data for deployment.
FEEDBACK_DATA_FILE=./data/feedback.json
# Copy to .env for local development. In production these are set as environment variables
# (Coolify), not committed. Only the required ones need a value to boot; the app degrades
# gracefully without the optional ones.
#
# --- Required ---
# OpenRouter API key, used for Zoe's replies and for summarising uploaded documents.
# AI_API_KEY=
# Postgres connection string. Prisma reads it for the app and for `prisma migrate deploy`.
# DATABASE_URL="postgresql://user:password@localhost:5432/contributors_helper"
# Google OAuth client ID and secret, used to sign contributors in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Public URL of this deployment, e.g. https://contributors.zedu.chat
# NEXTAUTH_URL=
# Random string used to sign session tokens.
# NEXTAUTH_SECRET=
#
# --- Optional ---
# Comma-separated emails that are always super admins. A super admin can promote other
# contributors to admin and trigger ingestion from the UI. Applied at sign-in.
# SUPER_ADMIN_EMAILS=
# Service token for server-to-server calls from the FE proxy.
# ZOE_SERVICE_TOKEN=
