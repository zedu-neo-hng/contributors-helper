# Server-side Groq API key. Never prefix this with NEXT_PUBLIC_.
AI_API_KEY=

# Configure an administrator account and a random session signing secret (32+ chars).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional: admin or lead. Defaults to admin.
ADMIN_ROLE=admin

# Feedback file location. Mount a persistent Coolify volume at /app/data for deployment.
FEEDBACK_DATA_FILE=./data/feedback.json
