# OpenRouter API key for server-side AI requests.
# AI_API_KEY=
# Shared secret for the operator upload/ingest API, sent as the x-ingest-secret header.
# Upload and ingest are disabled while this is unset.
# INGEST_SECRET=
# Postgres connection string (used by Prisma).
# DATABASE_URL="postgresql://user:password@localhost:5432/contributors_helper"
# Directory holding the compacted call knowledge base (summaries/ and transcripts/).
# Optional; defaults to ./clean-transcripts.
# KNOWLEDGE_DIR=
# Google OAuth client ID and secret for user authentication.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXTAUTH_URL=
# NEXTAUTH_SECRET=
