generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  createdAt DateTime @default(now())
  chats     Chat[]
}

model Chat {
  id        String    @id @default(cuid())
  userId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

model StagedDocument {
  id         String   @id @default(cuid())
  filename   String
  ext        String
  uploaderId String
  uploadedAt DateTime @default(now())
  status     String   @default("STAGED")
  data       Bytes
  ingested   IngestedDocument?

  @@index([status])
}

model IngestedDocument {
  id        String         @id @default(cuid())
  sourceId  String         @unique
  source    StagedDocument @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title     String
  summary   String         @db.Text
  cleaned   String         @db.Text
  createdAt DateTime       @default(now())
}
